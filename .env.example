# ==============================================================================
# EXPENSE TRACKER - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Sao chép file này thành .env trước khi khởi chạy hệ thống: cp .env.example .env
# ==============================================================================

# 1. Ứng dụng chung
PROJECT_NAME="Expense Tracker API"
ENVIRONMENT=production

# 2. Cơ sở dữ liệu PostgreSQL (Mục 1)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expense_tracker
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_tracker

# 3. Quản trị CSDL pgAdmin (Mục 1)
PGADMIN_EMAIL=admin@fintrack.com
PGADMIN_PASSWORD=Admin123456!
PGADMIN_PORT=5050

# 4. Bảo mật JWT & Xác thực (Mục 16)
JWT_SECRET_KEY=replace-with-a-random-secure-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# 5. Frontend & CORS
FRONTEND_URL=http://localhost

# 6. Google OAuth (Tùy chọn)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 7. Cấu hình Email SMTP (Tùy chọn)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@fintrack.local

# 8. Monitoring & Trực quan hoá (Mục 15: Prometheus & Grafana)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
